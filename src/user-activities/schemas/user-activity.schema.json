{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "user-activity",
  "title": "UserActivity",
  "description": "Documento MongoDB que registra una acción realizada por un usuario en la aplicación Sylvara. Colección: user_activities.",
  "type": "object",
  "required": ["user_id", "activity_type"],
  "properties": {
    "_id": {
      "type": "string",
      "description": "ObjectId generado automáticamente por MongoDB."
    },
    "user_id": {
      "type": "integer",
      "minimum": 1,
      "description": "FK lógica al campo user_id de la tabla PostgreSQL `users`."
    },
    "activity_type": {
      "type": "string",
      "description": "Tipo de acción realizada por el usuario.",
      "enum": [
        "login",
        "logout",
        "register",
        "viewDashboard",
        "viewProjects",
        "viewProjectDetail",
        "viewZoneDetail",
        "viewSpeciesList",
        "viewBenchmarking",
        "viewProfile",
        "viewExport",
        "viewIndices",
        "createProject",
        "updateProject",
        "updateProjectStatus",
        "deleteProject",
        "createZone",
        "updateZone",
        "deleteZone",
        "createSpecies",
        "updateSpecies",
        "deleteSpecies",
        "takeSnapshot",
        "sendBigquery",
        "downloadCsv",
        "generateCsv",
        "resetBenchmarking",
        "exportReport",
        "updateProfile",
        "changePassword",
        "deleteAccount"
      ]
    },
    "resource_type": {
      "type": ["string", "null"],
      "description": "Tipo del recurso afectado por la acción, si aplica.",
      "enum": ["project", "zone", "species", null],
      "default": null
    },
    "resource_id": {
      "type": ["string", "null"],
      "maxLength": 255,
      "description": "Identificador del recurso afectado (como string). Null si la acción no involucra un recurso específico.",
      "default": null
    },
    "metadata": {
      "type": ["object", "null"],
      "description": "Datos extra opcionales sobre la acción (e.g. nombre del proyecto, filtros aplicados).",
      "default": null,
      "examples": [
        { "nombre": "Parque Nacional Sierra Madre" },
        { "projectId": 5, "zoneName": "Zona A" },
        { "filters": { "status": "active" } }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp de creación generado automáticamente por Mongoose (timestamps: true)."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp de última actualización generado automáticamente por Mongoose (timestamps: true)."
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "_id": "65f3a2b1c4e7891234567890",
      "user_id": 5,
      "activity_type": "login",
      "resource_type": null,
      "resource_id": null,
      "metadata": null,
      "createdAt": "2026-03-11T23:20:00.000Z",
      "updatedAt": "2026-03-11T23:20:00.000Z"
    },
    {
      "_id": "65f3a2b1c4e7891234567891",
      "user_id": 5,
      "activity_type": "createProject",
      "resource_type": "project",
      "resource_id": "42",
      "metadata": { "nombre": "Parque Nacional Sierra Madre" },
      "createdAt": "2026-03-11T23:21:00.000Z",
      "updatedAt": "2026-03-11T23:21:00.000Z"
    },
    {
      "_id": "65f3a2b1c4e7891234567892",
      "user_id": 3,
      "activity_type": "viewZoneDetail",
      "resource_type": "zone",
      "resource_id": "7",
      "metadata": { "projectId": 42, "zoneName": "Zona B" },
      "createdAt": "2026-03-11T23:22:00.000Z",
      "updatedAt": "2026-03-11T23:22:00.000Z"
    }
  ]
}
