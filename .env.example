# ─────────────────────────────────────────────────────────────
# Sylvara Backend — Environment Variables Example
# Copy this file to .env and fill in your actual values.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ── PostgreSQL ───────────────────────────────────────────────
# When running locally (no Docker): use the remote IP
# When running with Docker Compose: use "postgres" (service name)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sylvara_user
POSTGRES_PASSWORD=sylvara_password
POSTGRES_DB=sylvara_db

# ── MongoDB ──────────────────────────────────────────────────
# When running locally (no Docker): use the remote URI
# When running with Docker Compose: use the service name
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=rootpassword
MONGO_DB=sylvara_db
MONGO_URI=mongodb://root:rootpassword@mongodb:27017/sylvara_db?authSource=admin

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=super_secret_key_change_me_in_production
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=30d

# ── Bcrypt ───────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=10

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/callback

# ── BigQuery ─────────────────────────────────────────────────
BQ_PROJECT_ID=your_gcp_project_id
BQ_DATASET_ID=benchmarking_warehouse
BQ_TABLE_ID=daily_query_metrics
